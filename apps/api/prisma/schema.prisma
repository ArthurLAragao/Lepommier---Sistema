generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// The original metadata table and migration are preserved.
model StoreSettings {
  id               Int      @id @default(1)
  businessTimezone String   @default("America/Fortaleza")
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  PRODUCTION
}

model InstallationState {
  id            Int       @id @default(1)
  initializedAt DateTime? @db.Timestamptz(3)
}

model User {
  id                    String                     @id @default(uuid()) @db.Uuid
  loginIdentifier       String                     @unique @db.VarChar(32)
  displayName           String                     @db.VarChar(80)
  passwordHash          String
  role                  Role
  active                Boolean                    @default(true)
  version               Int                        @default(1)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)
  sessions              Session[]
  auditEvents           AuditEvent[]
  marketingEvents       MarketingPreferenceEvent[]
  importJobs            ImportJob[]
  inventoryOperations   InventoryOperation[]
  inventoryBatches      Batch[]
  productionRecords     ProductionRecord[]
  purchasedReceipts     PurchasedProductReceipt[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  createdOrders         Order[]                    @relation("OrderCreator")
  orderEvents           OrderEvent[]
  payments              Payment[]
  refunds               Refund[]
  cashSessions          CashSession[]
  cashMovements         CashMovement[]
  cashClosings          CashClosing[]
  cashReviews           CashReview[]
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  tokenDigest String    @unique @db.Char(64)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String   @db.VarChar(40)
  actorId       String?  @db.Uuid
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targetId      String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  correlationId String   @db.VarChar(64)
  metadata      Json

  @@index([createdAt])
  @@index([actorId, eventType, createdAt])
}

model LoginThrottle {
  key             String   @id @db.VarChar(80)
  windowStartedAt DateTime @db.Timestamptz(3)
  attempts        Int

  @@index([windowStartedAt])
}

enum MarketingState {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum ProductOrigin {
  PRODUCED
  PURCHASED
  BOTH
}

enum ImportStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

model Customer {
  id                 String                     @id @default(uuid()) @db.Uuid
  registrationNumber Int                        @unique @default(autoincrement())
  name               String                     @db.VarChar(120)
  nameKey            String                     @db.VarChar(240)
  phone              String?                    @db.VarChar(14)
  email              String?                    @db.VarChar(254)
  birthday           DateTime?                  @db.Date
  cpf                String?                    @unique @db.VarChar(11)
  address            String?                    @db.VarChar(300)
  notes              String?                    @db.VarChar(1000)
  active             Boolean                    @default(true)
  anonymizedAt       DateTime?                  @db.Timestamptz(3)
  marketingState     MarketingState             @default(UNKNOWN)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
  version            Int                        @default(1)
  marketingEvents    MarketingPreferenceEvent[]
  orders             Order[]

  @@index([nameKey, id])
  @@index([phone])
  @@index([email])
  @@index([active, registrationNumber])
}

model MarketingPreferenceEvent {
  id            String         @id @default(uuid()) @db.Uuid
  customerId    String         @db.Uuid
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorId       String         @db.Uuid
  actor         User           @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  previousState MarketingState
  state         MarketingState
  source        String         @db.VarChar(32)
  reason        String         @db.VarChar(32)
  evidence      String?        @db.VarChar(200)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  nameKey   String    @unique @db.VarChar(240)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  version   Int       @default(1)
  products  Product[]
}

model Product {
  id                  String                    @id @default(uuid()) @db.Uuid
  code                String                    @unique @db.VarChar(32)
  name                String                    @db.VarChar(120)
  nameKey             String                    @db.VarChar(240)
  categoryId          String                    @db.Uuid
  category            Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  description         String?                   @db.VarChar(1000)
  origin              ProductOrigin
  sellingPriceCents   Int
  estimatedCostCents  Int?
  active              Boolean                   @default(true)
  storageInstructions String?                   @db.VarChar(500)
  shelfLifeReference  String?                   @db.VarChar(300)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  version             Int                       @default(1)
  batches             Batch[]
  productionRecords   ProductionRecord[]
  purchasedReceipts   PurchasedProductReceipt[]
  movements           InventoryMovement[]
  reservations        InventoryReservation[]
  allocations         ReservationAllocation[]
  orderItems          OrderItem[]

  @@index([categoryId, active])
  @@index([nameKey, id])
  @@index([active, origin])
}

enum BatchSource {
  OPENING
  PRODUCTION
  PURCHASED
  ADJUSTMENT
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MovementType {
  OPENING
  PRODUCTION_RECEIPT
  PURCHASED_RECEIPT
  CONSUMPTION
  WASTE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model InventoryOperation {
  id            String              @id @default(uuid()) @db.Uuid
  actorId       String              @db.Uuid
  actor         User                @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  key           String              @db.Uuid
  kind          String              @db.VarChar(32)
  requestDigest String              @db.Char(64)
  result        Json?
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?           @db.Timestamptz(3)
  movements     InventoryMovement[]
  payment       Payment?
  refund        Refund?
  cashSession   CashSession?
  cashMovement  CashMovement?
  cashClosing   CashClosing?
  cashReview    CashReview?

  @@unique([actorId, key])
  @@index([createdAt])
}

model Batch {
  id                  String                   @id @default(uuid()) @db.Uuid
  number              Int                      @unique @default(autoincrement())
  productId           String                   @db.Uuid
  product             Product                  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reference           String                   @db.VarChar(80)
  referenceKey        String                   @db.VarChar(160)
  source              BatchSource
  recordedAt          DateTime                 @db.Timestamptz(3)
  expiresAt           DateTime?                @db.Date
  expiryUnknownReason String?                  @db.VarChar(32)
  actorId             String                   @db.Uuid
  actor               User                     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  notes               String?                  @db.VarChar(500)
  physical            BigInt                   @default(0)
  reserved            BigInt                   @default(0)
  version             Int                      @default(1)
  movements           InventoryMovement[]
  allocations         ReservationAllocation[]
  production          ProductionRecord?
  receipt             PurchasedProductReceipt?

  @@unique([id, productId])
  @@unique([productId, referenceKey])
  @@index([productId, expiresAt, recordedAt, id])
}

model ProductionRecord {
  id              String           @id @default(uuid()) @db.Uuid
  productId       String           @db.Uuid
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorId         String           @db.Uuid
  actor           User             @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status          ProductionStatus @default(PLANNED)
  plannedQuantity Int
  actualQuantity  Int?
  plannedDate     DateTime         @db.Date
  notes           String?          @db.VarChar(500)
  createdAt       DateTime         @db.Timestamptz(3)
  startedAt       DateTime?        @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)
  cancelledAt     DateTime?        @db.Timestamptz(3)
  cancelReason    String?          @db.VarChar(32)
  version         Int              @default(1)
  batchId         String?          @unique @db.Uuid
  batch           Batch?           @relation(fields: [batchId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([batchId, productId])
  @@index([status, plannedDate, id])
  @@index([productId, plannedDate])
}

model PurchasedProductReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  batchId           String   @unique @db.Uuid
  batch             Batch    @relation(fields: [batchId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)
  quantity          Int
  supplierReference String   @db.VarChar(120)
  supplierBatch     String?  @db.VarChar(80)
  unitCostCents     Int?
  recordedAt        DateTime @db.Timestamptz(3)
  actorId           String   @db.Uuid
  actor             User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  notes             String?  @db.VarChar(500)

  @@unique([batchId, productId])
  @@index([productId, recordedAt])
}

model InventoryReservation {
  id                 String                  @id @default(uuid()) @db.Uuid
  productId          String                  @db.Uuid
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quantity           Int
  sourceNamespace    String                  @db.VarChar(24)
  sourceReference    String                  @db.Uuid
  eligibilityThrough DateTime                @db.Date
  actorId            String                  @db.Uuid
  actor              User                    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status             ReservationStatus       @default(ACTIVE)
  version            Int                     @default(1)
  createdAt          DateTime                @db.Timestamptz(3)
  closedAt           DateTime?               @db.Timestamptz(3)
  allocations        ReservationAllocation[]
  orderItemId        String?                 @unique @db.Uuid
  orderItem          OrderItem?              @relation(fields: [orderItemId, productId, quantity], references: [id, productId, quantity], onDelete: Restrict, onUpdate: NoAction)
  consumptions       InventoryMovement[]

  @@unique([orderItemId, productId, quantity])
  @@unique([id, productId])
  @@unique([sourceNamespace, sourceReference, productId])
  @@index([status, productId])
}

model ReservationAllocation {
  id            String               @id @default(uuid()) @db.Uuid
  productId     String               @db.Uuid
  product       Product              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservationId String               @db.Uuid
  reservation   InventoryReservation @relation(fields: [reservationId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)
  batchId       String               @db.Uuid
  batch         Batch                @relation(fields: [batchId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)
  allocated     Int
  released      Int                  @default(0)
  consumed      Int                  @default(0)

  @@unique([reservationId, batchId])
  @@index([batchId])
}

model InventoryMovement {
  id                 String                @id @default(uuid()) @db.Uuid
  productId          String                @db.Uuid
  product            Product               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  batchId            String                @db.Uuid
  batch              Batch                 @relation(fields: [batchId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)
  operationId        String                @db.Uuid
  operation          InventoryOperation    @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorId            String                @db.Uuid
  actor              User                  @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  type               MovementType
  quantity           Int
  reason             String                @db.VarChar(32)
  notes              String?               @db.VarChar(500)
  createdAt          DateTime              @db.Timestamptz(3)
  correctsMovementId String?               @db.Uuid
  correctsMovement   InventoryMovement?    @relation("MovementCorrection", fields: [correctsMovementId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  corrections        InventoryMovement[]   @relation("MovementCorrection")
  reservationId      String?               @db.Uuid
  reservation        InventoryReservation? @relation(fields: [reservationId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([operationId, batchId, type])
  @@index([reservationId])
  @@index([productId, createdAt, id])
  @@index([batchId, createdAt, id])
}

enum OrderSource {
  COUNTER
  WHATSAPP
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  READY
  FULFILLED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
}

model CashSession {
  id                String             @id @default(uuid()) @db.Uuid
  openedAt          DateTime           @db.Timestamptz(3)
  openedById        String             @db.Uuid
  openedBy          User               @relation(fields: [openedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  openingFloatCents BigInt
  closedAt          DateTime?          @db.Timestamptz(3)
  operationId       String             @unique @db.Uuid
  operation         InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payments          Payment[]
  refunds           Refund[]
  activityVersion   Int                @default(1)
  reviewVersion     Int                @default(0)
  legacyClosed      Boolean            @default(false)
  closing           CashClosing?
  movements         CashMovement[]
  reviews           CashReview[]

  @@index([openedAt, id])
  @@index([closedAt, id])
}

enum CashMovementKind {
  CASH_ADDITION
  CASH_WITHDRAWAL
  CASH_EXPENSE
  CASH_REVERSAL
}

enum CashReviewDecision {
  APPROVED
  NEEDS_ATTENTION
}

model CashMovement {
  id          String             @id @default(uuid()) @db.Uuid
  sessionId   String             @db.Uuid
  session     CashSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kind        CashMovementKind
  amountCents BigInt
  direction   Int
  reason      String             @db.VarChar(240)
  category    String?            @db.VarChar(24)
  reference   String?            @db.VarChar(64)
  actorId     String             @db.Uuid
  actor       User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recordedAt  DateTime           @db.Timestamptz(3)
  operationId String             @unique @db.Uuid
  operation   InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversesId  String?            @unique @db.Uuid
  reverses    CashMovement?      @relation("CashReversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversal    CashMovement?      @relation("CashReversal")

  @@index([sessionId, recordedAt, id])
}

model CashClosing {
  sessionId       String             @id @db.Uuid
  session         CashSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activityVersion Int
  expectedCents   BigInt
  countedCents    BigInt
  differenceCents BigInt
  explanation     String?            @db.VarChar(500)
  totals          Json
  actorId         String             @db.Uuid
  actor           User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recordedAt      DateTime           @db.Timestamptz(3)
  operationId     String             @unique @db.Uuid
  operation       InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model CashReview {
  id          String             @id @default(uuid()) @db.Uuid
  sessionId   String             @db.Uuid
  session     CashSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  version     Int
  decision    CashReviewDecision
  note        String             @db.VarChar(500)
  actorId     String             @db.Uuid
  actor       User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recordedAt  DateTime           @db.Timestamptz(3)
  operationId String             @unique @db.Uuid
  operation   InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([sessionId, version])
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  number         Int          @unique @default(autoincrement())
  source         OrderSource
  customerId     String?      @db.Uuid
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status         OrderStatus  @default(DRAFT)
  subtotalCents  BigInt
  discountCents  BigInt       @default(0)
  discountReason String?      @db.VarChar(32)
  totalCents     BigInt
  pickupAt       DateTime?    @db.Timestamptz(3)
  pickupPerson   String?      @db.VarChar(120)
  collectionNote String?      @db.VarChar(500)
  notes          String?      @db.VarChar(1000)
  createdAt      DateTime     @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  confirmedAt    DateTime?    @db.Timestamptz(3)
  preparingAt    DateTime?    @db.Timestamptz(3)
  readyAt        DateTime?    @db.Timestamptz(3)
  fulfilledAt    DateTime?    @db.Timestamptz(3)
  cancelledAt    DateTime?    @db.Timestamptz(3)
  cancelReason   String?      @db.VarChar(32)
  creatorId      String       @db.Uuid
  creator        User         @relation("OrderCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  version        Int          @default(1)
  items          OrderItem[]
  payment        Payment?
  refund         Refund?
  events         OrderEvent[]

  @@index([customerId, fulfilledAt, id])
  @@index([status, pickupAt, id])
  @@index([source, createdAt, id])
}

model OrderItem {
  id             String                @id @default(uuid()) @db.Uuid
  orderId        String                @db.Uuid
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productId      String                @db.Uuid
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productCode    String                @db.VarChar(32)
  productName    String                @db.VarChar(120)
  productVersion Int
  quantity       Int
  unitPriceCents Int
  subtotalCents  BigInt
  discountCents  BigInt
  totalCents     BigInt
  reservation    InventoryReservation?

  @@unique([orderId, productId])
  @@unique([id, productId, quantity])
}

model Payment {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @unique @db.Uuid
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  amountCents       BigInt
  method            PaymentMethod
  tenderedCents     BigInt?
  changeCents       BigInt?
  manuallyConfirmed Boolean
  actorId           String             @db.Uuid
  actor             User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recordedAt        DateTime           @db.Timestamptz(3)
  cashSessionId     String             @db.Uuid
  cashSession       CashSession        @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operationId       String             @unique @db.Uuid
  operation         InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  refund            Refund?

  @@unique([id, orderId])
  @@index([cashSessionId, method, recordedAt])
}

model Refund {
  id                      String             @id @default(uuid()) @db.Uuid
  paymentId               String             @unique @db.Uuid
  payment                 Payment            @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  orderId                 String             @unique @db.Uuid
  order                   Order              @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  amountCents             BigInt
  method                  PaymentMethod
  reason                  String             @db.VarChar(32)
  externalRefundConfirmed Boolean
  actorId                 String             @db.Uuid
  actor                   User               @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recordedAt              DateTime           @db.Timestamptz(3)
  cashSessionId           String             @db.Uuid
  cashSession             CashSession        @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operationId             String             @unique @db.Uuid
  operation               InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([paymentId, orderId])
  @@index([cashSessionId, method, recordedAt])
}

model OrderEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  type      String      @db.VarChar(32)
  state     OrderStatus
  reason    String?     @db.VarChar(32)
  actorId   String      @db.Uuid
  actor     User        @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime    @db.Timestamptz(3)

  @@index([orderId, createdAt, id])
}

model ImportJob {
  id             String       @id @default(uuid()) @db.Uuid
  actorId        String       @db.Uuid
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tokenDigest    String       @db.Char(64)
  status         ImportStatus @default(PENDING)
  rowCount       Int
  decisionDigest String?      @db.Char(64)
  result         Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime     @db.Timestamptz(3)
  closedAt       DateTime?    @db.Timestamptz(3)

  @@index([status, expiresAt])
  @@index([actorId, createdAt])
}
