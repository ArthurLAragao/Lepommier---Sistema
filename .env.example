# Copy to .env and supply a unique password. Do not use example values on store data.
POSTGRES_USER=pommier
POSTGRES_PASSWORD=CHANGE_ME_TO_A_UNIQUE_PASSWORD
POSTGRES_DB=le_pommier
DATABASE_URL=postgresql://pommier:CHANGE_ME_TO_A_UNIQUE_PASSWORD@127.0.0.1:5432/le_pommier?schema=public
HOST=127.0.0.1
PORT=3333
NODE_ENV=development
# Production serves local assets from this directory relative to repository root.
WEB_DIST=apps/web/dist
# Leave PUBLIC_ORIGIN unset for the normal local dev/production addresses.
# For an explicitly configured HTTPS local proxy use its exact origin (no slash).
# PUBLIC_ORIGIN=https://localhost
INSTALLATION_SECRET_FILE=data/installation-secret
# Never point integration tests at the operational database.
TEST_DATABASE_URL=postgresql://pommier:CHANGE_ME_TO_A_UNIQUE_PASSWORD@127.0.0.1:5433/le_pommier_test?schema=public
